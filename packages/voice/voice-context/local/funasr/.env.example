# Copy this file to .env and adjust values when needed.
# A request-level model field can select iic/SenseVoiceSmall, small, medium,
# or large-v3. STT_MODEL is used only when a request sends model=local.
STT_MODEL=iic/SenseVoiceSmall
STT_MODEL_ROOT=./models/faster-whisper
STT_DEVICE=cpu
STT_HOST=127.0.0.1
STT_PORT=8000
